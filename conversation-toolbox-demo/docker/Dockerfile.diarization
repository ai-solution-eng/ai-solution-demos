FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app

RUN apt-get update && apt-get install -y ffmpeg gcc && rm -rf /var/lib/apt/lists/*

WORKDIR ${APP_HOME}

COPY src/speech_to_speech_tools/diarization_service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/speech_to_speech_tools/diarization_service/ ./

ENV PYTHONPATH="/app"

EXPOSE 8001

CMD ["python", "server.py"]
