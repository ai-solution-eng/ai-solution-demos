# Variables the services read. In the cluster the Helm chart sets them from its values, with the
# credentials coming from Kubernetes Secrets; this file is only a reference for running a service
# on its own.

# All services
# development runs Next.js and uvicorn with live reload; production runs the built app.
ENV=development
# Port the service listens on: app-ui 3000, kafka-service 8001, llm-service 8002, video-service 8003.
PORT=3000
# Settings file (model, Kafka broker and topic) written by app-ui and read by the backends.
CONFIG_PATH=/app/data/config.json
# Defaults (chart values llm.model, kafka.broker, kafka.topic) until System Config saves its own.
LLM_MODEL=
KAFKA_BROKER=
KAFKA_TOPIC=

# app-ui: who may change System Config. oidc checks the Keycloak ID token; open is for dev only.
SETTINGS_AUTH=oidc
OIDC_ISSUER=https://keycloak.<domain>/realms/UA
OIDC_AUDIENCE=ua
# Keycloak signing keys; empty means <OIDC_ISSUER>/protocol/openid-connect/certs.
OIDC_JWKS_URL=
ADMIN_ROLE=admin
# app-ui under `next dev` only: hostnames allowed to use live reload (the Tiltfile sets its own).
ALLOWED_DEV_ORIGINS=

# llm-service: the model endpoint, LiteLLM or another OpenAI-compatible server such as an HPE MLIS
# deployment, and the app's key for it (chart values llm.baseUrl and llm.apiKey).
LITELLM_BASE_URL=http://litellm.litellm.svc.cluster.local:4000
LITELLM_API_KEY=<set-in-secret>
# What the model accepts where the endpoint does not declare it (chart values llm.capabilities):
# true or false; leave them unset for unknown (an empty value is not accepted).
# LLM_SUPPORTS_VISION=true
# LLM_SUPPORTS_VIDEO=true
# LLM_SUPPORTS_REASONING=true
VIDEO_SERVICE_URL=http://127.0.0.1:8003
MAX_IMAGES=5

# kafka-service: connection and credentials (chart values kafka.*).
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=<set-in-secret>
KAFKA_SASL_PASSWORD=<set-in-secret>

# video-service: where custom uploads go and how large they may be.
UPLOAD_DIR=/app/data/videos
MAX_UPLOAD_MB=200
