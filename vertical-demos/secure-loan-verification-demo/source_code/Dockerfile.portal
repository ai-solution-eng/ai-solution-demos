# Portal: build with Vite, serve static with nginx.
FROM node:20-alpine AS build
WORKDIR /app
COPY source_code/portal/package.json source_code/portal/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY source_code/portal/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY source_code/portal/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
