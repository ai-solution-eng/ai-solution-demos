{
  "$schema": "https://opencode.ai/config.json",

  // This is a TEMPLATE — copy to your project root (or load via
  // OPENCODE_CONFIG=documentation/opencode.jsonc) before running opencode.
  // AGENTS.md is symlinked at the repo root → documentation/AGENTS.md, so
  // opencode auto-loads it (no "instructions" field needed).

  // ── Multimodal RAG MCP server (2026-10 unified config) ──────────────────
  // ONE connection, ALL tools. Auth is per-IDENTITY, enforced server-side:
  //   • The bearer is a Keycloak OIDC access token (D21) — it resolves to the
  //     SAME per-user identity as your browser SSO — or a minted per-user
  //     registry key (D15/D17), sent as the bearer or X-API-Key.
  //   • The memory dataset + password resolve server-side from the caller's
  //     ★ binding + saved selection (D16 access store): open the /access page
  //     signed in as your identity, select the dataset (password once), ★ it.
  //     NO secret rides any header here.
  //   • Legacy key-unconfigured (single-user) deployments: this exact config
  //     still works unauthenticated; to pin the memory dataset explicitly,
  //     re-add X-Memory-Dataset / X-Dataset-Password headers (env-resolved) —
  //     see MCP.md § 3.2 for the legacy two-connection pattern.
  //
  // REQUIRED env var:
  //   MM_RAG_BEARER_TOKEN  Keycloak UA access token — rotate per session
  //                        (~15-day validity on G2); never bake the value in.
  //   (The session-memory-logger plugin reads the same var, or
  //   RAG_MEMORY_BEARER_TOKEN as a plugin-specific override.)
  //
  // URL: https://rag-mcp-server.<YOUR-DOMAIN>/mcp (cluster ingress), or
  //   kubectl port-forward deployment/rag-mcp-server 8001:9090 →
  //   http://localhost:8001/mcp (local testing; token may still be required).
  "mcp": {
    "rag": {
      "type": "remote",
      "url": "https://rag-mcp-server.YOUR-DOMAIN/mcp",
      "headers": {
        "Authorization": "Bearer {env:MM_RAG_BEARER_TOKEN}"
      }
    }
  }
}
