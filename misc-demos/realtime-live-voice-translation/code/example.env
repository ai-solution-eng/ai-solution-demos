ASR_BASE_URL=MLIS_MODEL_ENDPOINT/v1
ASR_API_KEY=MLIS_MODEL_API_KEY
ASR_MODEL=openai/whisper-large-v3-turbo
LLM_BASE_URL=MLIS_MODEL_ENDPOINT/v1
LLM_API_KEY=MLIS_MODEL_API_KEY
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
TTS_BASE_URL=MLIS_MODEL_ENDPOINT/v1
TTS_API_KEY=MLIS_MODEL_API_KEY
TTS_MODEL=fishaudio/s2-pro
TTS_VOICE=alys
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgresql.postgresql.svc.cluster.local:5432/DATABASE
SESSION_STORAGE_ROOT=/data/realtime-sessions
SESSION_TTL_HOURS=12
HALLUCINATION_PATTERNS=thank you,thanks,продолжение следует
# Live latency tuning (see PERFORMANCE_AUDIT.md Tier 0)
LIVE_SILENCE_THRESHOLD_MS=1000
LIVE_INCOMPLETE_FINALIZE_MS=1700
LIVE_PARTIAL_UPDATE_MS=500
LIVE_MIN_PARTIAL_AUDIO_MS=500
# Presenter authentication (attendees join with the room code only, by design).
PRESENTER_AUTH_ENABLED=true
# Set a stable secret so presenter tokens survive restarts; leave empty for a per-process random secret.
# PRESENTER_AUTH_SECRET=<random 64-hex string>
